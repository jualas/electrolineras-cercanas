# Vacío en web/dev con proxy Vite. En APK apunta a la API de Electrolineras (sin OSRM).
VITE_API_URL=https://electro.jualas.es

# Opcional, SOLO para desarrollo local: token de servicio (header X-Private-Token).
# Vite lo incrusta en el JS compilado: déjalo vacío al generar un APK que compartas.
# VITE_PRIVATE_TOKEN=

# Visor Google Maps JS (clave web restringida por HTTP referrer únicamente a Maps JavaScript API)
# Si se deja vacía o VITE_MAP_PROVIDER=maplibre, se usa MapLibre.
VITE_GOOGLE_MAPS_JS_API_KEY=
# VITE_MAP_PROVIDER=google
